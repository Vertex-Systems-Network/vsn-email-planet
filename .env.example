# Synthetic local demo only. Live-provider credentials are not configured in this prototype.
APP_ENV=development
APP_PORT=4173

# Set only for first-admin bootstrap. Use 32 random bytes encoded as base64url (43 chars).
# Never commit the generated value; remove/rotate it after bootstrap is claimed.
APP_ORIGIN=
PLATFORM_BOOTSTRAP_TOKEN=

# Shared identity attempt throttling; generate 32 random bytes and base64url encode (43 chars).
# Keep stable; during rotation set the old value as previous for at least 24 hours.
PLATFORM_THROTTLE_HMAC_KEY=
PLATFORM_THROTTLE_HMAC_PREVIOUS_KEY=
